from frappe.website.page_renderers.template_page import TemplatePage


ASSET_MARKER = "aimatic-lms-learning-assets"
ASSET_TAGS = f'''<!-- {ASSET_MARKER} -->
<link rel="stylesheet" href="/assets/aimaticlearning/css/lms_learning.css?v=20260830-3">
<link rel="stylesheet" href="/assets/aimaticlearning/css/lms_kinnu.css?v=20260830-3">
<link rel="stylesheet" href="/assets/aimaticlearning/css/lms_student_experience.css?v=20260830-3">
<script defer src="/assets/aimaticlearning/js/lms_learning.js?v=20260830-3"></script>
<script defer src="/assets/aimaticlearning/js/lms_kinnu.js?v=20260830-3"></script>
<script defer src="/assets/aimaticlearning/js/lms_student_experience.js?v=20260830-3"></script>'''


class AimaticLMSPageRenderer(TemplatePage):
	"""Decorate the LMS-owned SPA shell with Aimatic's learner experience assets."""

	def can_render(self):
		return self.path == "_lms" and super().can_render()

	def render(self):
		response = super().render()
		html = response.get_data(as_text=True)
		if ASSET_MARKER not in html:
			html = html.replace("</head>", f"{ASSET_TAGS}\n</head>", 1)
			response.set_data(html)
		return response
