		"queries": {
			"tq-tax-pos": {
				"name": "tq-tax-pos",
				"title": "POS Invoices",
				"workbook": "aimatic-tax-compliance",
				"folder": null,
				"sort_order": 0,
				"use_live_connection": 1,
				"is_script_query": 0,
				"is_builder_query": 1,
				"is_native_query": 0,
				"operations": [
					{
						"type": "source",
						"table": {
							"type": "table",
							"data_source": "Site DB",
							"table_name": "tabPOS Invoice"
						}
					},
					{
						"type": "filter_group",
						"logical_operator": "And",
						"filters": [
							{
								"column": {
									"type": "column",
									"column_name": "docstatus"
								},
								"operator": "=",
								"value": 1
							}
						]
					},
					{
						"type": "mutate",
						"new_name": "submission_status",
						"data_type": "String",
						"expression": {
							"type": "expression",
							"expression": "cases((custom_fbr_status == 'Accepted', 'Accepted'), (custom_fbr_status == 'Failed', 'Failed'), (custom_fbr_status == 'Not Sent', 'Not sent'), else_='Other')"
						}
					},
					{
						"type": "mutate",
						"new_name": "is_return_flag",
						"data_type": "String",
						"expression": {
							"type": "expression",
							"expression": "if_else(is_return == 1, 'Return', 'Sale')"
						}
					}
				]
			},
			"tq-tax-rows": {
				"name": "tq-tax-rows",
				"title": "POS Tax Rows",
				"workbook": "aimatic-tax-compliance",
				"folder": null,
				"sort_order": 1,
				"use_live_connection": 1,
				"is_script_query": 0,
				"is_builder_query": 1,
				"is_native_query": 0,
				"operations": [
					{
						"type": "source",
						"table": {
							"type": "table",
							"data_source": "Site DB",
							"table_name": "tabSales Taxes and Charges"
						}
					},
					{
						"type": "filter_group",
						"logical_operator": "And",
						"filters": [
							{
								"column": {
									"type": "column",
									"column_name": "docstatus"
								},
								"operator": "=",
								"value": 1
							},
							{
								"column": {
									"type": "column",
									"column_name": "parenttype"
								},
								"operator": "=",
								"value": "POS Invoice"
							}
						]
					},
					{
						"type": "join",
						"join_type": "inner",
						"table": {
							"type": "table",
							"data_source": "Site DB",
							"table_name": "tabPOS Invoice"
						},
						"select_columns": [
							{
								"type": "column",
								"column_name": "posting_date"
							},
							{
								"type": "column",
								"column_name": "company"
							},
							{
								"type": "column",
								"column_name": "branch"
							}
						],
						"join_condition": {
							"left_column": {
								"type": "column",
								"column_name": "parent"
							},
							"right_column": {
								"type": "column",
								"column_name": "name"
							}
						}
					},
					{
						"type": "mutate",
						"new_name": "output_tax_amount",
						"data_type": "Decimal",
						"expression": {
							"type": "expression",
							"expression": "if_else(description == 'FBR Sales Tax', base_tax_amount, 0)"
						}
					},
					{
						"type": "mutate",
						"new_name": "pos_fee_amount",
						"data_type": "Decimal",
						"expression": {
							"type": "expression",
							"expression": "if_else(description == 'FBR POS Service Fee', base_tax_amount, 0)"
						}
					},
					{
						"type": "mutate",
						"new_name": "charge_kind",
						"data_type": "String",
						"expression": {
							"type": "expression",
							"expression": "cases((description == 'FBR POS Service Fee', 'POS service fee'), (description == 'FBR Sales Tax', 'Output tax'), else_='Other charge')"
						}
					}
				]
			}
		},
