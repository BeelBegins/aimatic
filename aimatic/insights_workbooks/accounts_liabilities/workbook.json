{
	"version": "1.0",
	"type": "Workbook",
	"name": "aimatic-accounts-liabilities",
	"doc": {
		"name": "aimatic-accounts-liabilities",
		"title": "Liabilities and Payables"
	},
	"dependencies": {
		"folders": [],
		"queries": {
			"tq-liab-gl": {
				"name": "tq-liab-gl",
				"title": "Liability GL movement",
				"workbook": "aimatic-accounts-liabilities",
				"folder": null,
				"sort_order": 0,
				"use_live_connection": 1,
				"is_script_query": 0,
				"is_builder_query": 1,
				"is_native_query": 0,
				"operations": [
					{
						"type": "source",
						"table": {
							"type": "table",
							"data_source": "Site DB",
							"table_name": "tabGL Entry"
						}
					},
					{
						"type": "filter_group",
						"logical_operator": "And",
						"filters": [
							{
								"column": {
									"type": "column",
									"column_name": "is_cancelled"
								},
								"operator": "=",
								"value": 0
							}
						]
					},
					{
						"type": "join",
						"join_type": "inner",
						"table": {
							"type": "table",
							"data_source": "Site DB",
							"table_name": "tabAccount"
						},
						"select_columns": [
							{
								"type": "column",
								"column_name": "root_type"
							},
							{
								"type": "column",
								"column_name": "account_type"
							},
							{
								"type": "column",
								"column_name": "account_name"
							}
						],
						"join_condition": {
							"left_column": {
								"type": "column",
								"column_name": "account"
							},
							"right_column": {
								"type": "column",
								"column_name": "name"
							}
						}
					},
					{
						"type": "mutate",
						"new_name": "liability_amount",
						"data_type": "Decimal",
						"expression": {
							"type": "expression",
							"expression": "if_else(root_type == 'Liability', credit - debit, 0)"
						}
					},
					{
						"type": "mutate",
						"new_name": "tax_payable_amount",
						"data_type": "Decimal",
						"expression": {
							"type": "expression",
							"expression": "if_else((root_type == 'Liability') & (account_type == 'Tax'), credit - debit, 0)"
						}
					},
					{
						"type": "mutate",
						"new_name": "trade_payable_amount",
						"data_type": "Decimal",
						"expression": {
							"type": "expression",
							"expression": "if_else((root_type == 'Liability') & (account_type == 'Payable'), credit - debit, 0)"
						}
					},
					{
						"type": "mutate",
						"new_name": "pos_fee_payable_amount",
						"data_type": "Decimal",
						"expression": {
							"type": "expression",
							"expression": "if_else((root_type == 'Liability') & (account_type == 'Liability'), credit - debit, 0)"
						}
					}
				]
			},
			"tq-liab-snap": {
				"name": "tq-liab-snap",
				"title": "Liability outstanding snapshot",
				"workbook": "aimatic-accounts-liabilities",
				"folder": null,
				"sort_order": 1,
				"use_live_connection": 1,
				"is_script_query": 0,
				"is_builder_query": 0,
				"is_native_query": 1,
				"operations": [
					{
						"type": "sql",
						"data_source": "Site DB",
						"raw_sql": "SELECT\n\ta.account_name,\n\ta.account_type,\n\ta.root_type,\n\tgl.company,\n\tSUM(gl.credit - gl.debit) AS outstanding\nFROM `tabGL Entry` gl\nINNER JOIN `tabAccount` a ON a.name = gl.account\nWHERE IFNULL(gl.is_cancelled, 0) = 0\n\tAND a.root_type = 'Liability'\nGROUP BY a.account_name, a.account_type, a.root_type, gl.company"
					}
				]
			},
			"tq-pending-pi": {
				"name": "tq-pending-pi",
				"title": "Unpaid purchase invoices",
				"workbook": "aimatic-accounts-liabilities",
				"folder": null,
				"sort_order": 2,
				"use_live_connection": 1,
				"is_script_query": 0,
				"is_builder_query": 0,
				"is_native_query": 1,
				"operations": [
					{
						"type": "sql",
						"data_source": "Site DB",
						"raw_sql": "SELECT\n\tposting_date,\n\tdue_date,\n\tcompany,\n\tsupplier_name,\n\tname AS invoice,\n\tbill_no,\n\tstatus,\n\toutstanding_amount,\n\tbase_grand_total,\n\tDATEDIFF(CURDATE(), due_date) AS days_overdue\nFROM `tabPurchase Invoice`\nWHERE docstatus = 1 AND outstanding_amount > 0.005"
					}
				]
			}
		},
