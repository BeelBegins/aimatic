	"dependencies": {
		"folders": [],
		"queries": {
			"tq-gl": {
				"name": "tq-gl",
				"title": "GL Entries",
				"workbook": "aimatic-accounts-pnl",
				"folder": null,
				"sort_order": 0,
				"use_live_connection": 1,
				"is_script_query": 0,
				"is_builder_query": 1,
				"is_native_query": 0,
				"operations": [
					{
						"type": "source",
						"table": {
							"type": "table",
							"data_source": "Site DB",
							"table_name": "tabGL Entry"
						}
					},
					{
						"type": "filter_group",
						"logical_operator": "And",
						"filters": [
							{
								"column": {
									"type": "column",
									"column_name": "is_cancelled"
								},
								"operator": "=",
								"value": 0
							}
						]
					},
					{
						"type": "join",
						"join_type": "inner",
						"table": {
							"type": "table",
							"data_source": "Site DB",
							"table_name": "tabAccount"
						},
						"select_columns": [
							{
								"type": "column",
								"column_name": "root_type"
							},
							{
								"type": "column",
								"column_name": "account_type"
							},
							{
								"type": "column",
								"column_name": "account_name"
							}
						],
						"join_condition": {
							"left_column": {
								"type": "column",
								"column_name": "account"
							},
							"right_column": {
								"type": "column",
								"column_name": "name"
							}
						}
					},
					{
						"type": "mutate",
						"new_name": "merchandise_income",
						"data_type": "Decimal",
						"expression": {
							"type": "expression",
							"expression": "if_else((root_type == 'Income') & (account_type != 'Tax'), credit - debit, 0)"
						}
					},
					{
						"type": "mutate",
						"new_name": "expense_amount",
						"data_type": "Decimal",
						"expression": {
							"type": "expression",
							"expression": "if_else(root_type == 'Expense', debit - credit, 0)"
						}
					},
					{
						"type": "mutate",
						"new_name": "net_amount",
						"data_type": "Decimal",
						"expression": {
							"type": "expression",
							"expression": "merchandise_income - expense_amount"
						}
					}
				]
			}
		},
