			"tq-sle": {
				"name": "tq-sle",
				"title": "Stock movements",
				"workbook": "aimatic-inventory-kpis",
				"folder": null,
				"sort_order": 1,
				"use_live_connection": 1,
				"is_script_query": 0,
				"is_builder_query": 1,
				"is_native_query": 0,
				"operations": [
					{
						"type": "source",
						"table": {
							"type": "table",
							"data_source": "Site DB",
							"table_name": "tabStock Ledger Entry"
						}
					},
					{
						"type": "filter_group",
						"logical_operator": "And",
						"filters": [
							{
								"column": {
									"type": "column",
									"column_name": "is_cancelled"
								},
								"operator": "=",
								"value": 0
							}
						]
					},
					{
						"type": "mutate",
						"new_name": "cogs_value",
						"data_type": "Decimal",
						"expression": {
							"type": "expression",
							"expression": "if_else(actual_qty < 0, -stock_value_difference, 0)"
						}
					},
					{
						"type": "mutate",
						"new_name": "inbound_value",
						"data_type": "Decimal",
						"expression": {
							"type": "expression",
							"expression": "if_else(actual_qty > 0, stock_value_difference, 0)"
						}
					}
				]
			},
			"tq-dead": {
				"name": "tq-dead",
				"title": "Slow / no-movement stock (90 days)",
				"workbook": "aimatic-inventory-kpis",
				"folder": null,
				"sort_order": 2,
				"use_live_connection": 1,
				"is_script_query": 0,
				"is_builder_query": 0,
				"is_native_query": 1,
				"operations": [
					{
						"type": "sql",
						"data_source": "Site DB",
						"raw_sql": "WITH last_out AS (\n\tSELECT item_code, warehouse, MAX(posting_date) AS last_out\n\tFROM `tabStock Ledger Entry`\n\tWHERE IFNULL(is_cancelled, 0) = 0 AND actual_qty < 0\n\tGROUP BY item_code, warehouse\n)\nSELECT\n\tb.item_code,\n\ti.item_name,\n\ti.item_group,\n\tb.warehouse,\n\tb.actual_qty,\n\tb.stock_value,\n\tlo.last_out,\n\tDATEDIFF(CURDATE(), lo.last_out) AS days_since_out\nFROM `tabBin` b\nINNER JOIN `tabItem` i ON i.name = b.item_code\nLEFT JOIN last_out lo ON lo.item_code = b.item_code AND lo.warehouse = b.warehouse\nWHERE b.actual_qty > 0\n\tAND (lo.last_out IS NULL OR lo.last_out < DATE_SUB(CURDATE(), INTERVAL 90 DAY))"
					}
				]
			},
			"tq-wh-branch-gst": {
				"name": "tq-wh-branch-gst",
				"title": "Stock by warehouse & branch (incl. GST)",
				"workbook": "aimatic-inventory-kpis",
				"folder": null,
				"sort_order": 3,
				"use_live_connection": 1,
				"is_script_query": 0,
				"is_builder_query": 0,
				"is_native_query": 1,
				"operations": [
					{
						"type": "sql",
						"data_source": "Site DB",
						"raw_sql": "SELECT\n\tw.company,\n\tb.warehouse,\n\tw.custom_branch AS branch,\n\tSUM(b.actual_qty) AS qty,\n\tCOUNT(DISTINCT b.item_code) AS skus,\n\tSUM(b.stock_value) AS stock_value_excl_gst,\n\tSUM(b.stock_value * IFNULL(ftc.tax_rate, 0) / 100) AS gst_value,\n\tSUM(b.stock_value * (100 + IFNULL(ftc.tax_rate, 0)) / 100) AS stock_value_incl_gst\nFROM `tabBin` b\nINNER JOIN `tabWarehouse` w ON w.name = b.warehouse\nINNER JOIN `tabItem` i ON i.name = b.item_code\nLEFT JOIN `tabFBR Tax Category` ftc ON ftc.name = i.custom_fbr_tax_category\nGROUP BY w.company, b.warehouse, w.custom_branch"
					}
				]
			}
		},
