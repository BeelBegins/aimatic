		"queries": {
			"tq-draft-pi": {
				"name": "tq-draft-pi",
				"title": "Draft purchase invoices",
				"workbook": "aimatic-pending-work",
				"folder": null,
				"sort_order": 0,
				"use_live_connection": 1,
				"is_script_query": 0,
				"is_builder_query": 0,
				"is_native_query": 1,
				"operations": [
					{
						"type": "sql",
						"data_source": "Site DB",
						"raw_sql": "SELECT\n\tposting_date,\n\tcompany,\n\tsupplier_name,\n\tname AS invoice,\n\tbill_no,\n\tgrand_total,\n\tstatus\nFROM `tabPurchase Invoice`\nWHERE docstatus = 0"
					}
				]
			},
			"tq-open-po": {
				"name": "tq-open-po",
				"title": "Open purchase orders",
				"workbook": "aimatic-pending-work",
				"folder": null,
				"sort_order": 1,
				"use_live_connection": 1,
				"is_script_query": 0,
				"is_builder_query": 0,
				"is_native_query": 1,
				"operations": [
					{
						"type": "sql",
						"data_source": "Site DB",
						"raw_sql": "SELECT\n\ttransaction_date,\n\tschedule_date,\n\tcompany,\n\tsupplier_name,\n\tname AS purchase_order,\n\tstatus,\n\tper_received,\n\tgrand_total\nFROM `tabPurchase Order`\nWHERE docstatus = 1\n\tAND status IN ('To Receive', 'To Receive and Bill', 'To Bill')"
					}
				]
			},
			"tq-open-si": {
				"name": "tq-open-si",
				"title": "Unpaid sales invoices",
				"workbook": "aimatic-pending-work",
				"folder": null,
				"sort_order": 2,
				"use_live_connection": 1,
				"is_script_query": 0,
				"is_builder_query": 0,
				"is_native_query": 1,
				"operations": [
					{
						"type": "sql",
						"data_source": "Site DB",
						"raw_sql": "SELECT\n\tposting_date,\n\tdue_date,\n\tcompany,\n\tcustomer_name,\n\tname AS invoice,\n\tstatus,\n\toutstanding_amount,\n\tDATEDIFF(CURDATE(), due_date) AS days_overdue\nFROM `tabSales Invoice`\nWHERE docstatus = 1\n\tAND outstanding_amount > 0.005\n\tAND IFNULL(is_pos, 0) = 0"
					}
				]
			},
			"tq-unpaid-pi": {
				"name": "tq-unpaid-pi",
				"title": "Unpaid purchase invoices",
				"workbook": "aimatic-pending-work",
				"folder": null,
				"sort_order": 3,
				"use_live_connection": 1,
				"is_script_query": 0,
				"is_builder_query": 0,
				"is_native_query": 1,
				"operations": [
					{
						"type": "sql",
						"data_source": "Site DB",
						"raw_sql": "SELECT\n\tposting_date,\n\tdue_date,\n\tcompany,\n\tsupplier_name,\n\tname AS invoice,\n\tbill_no,\n\tstatus,\n\toutstanding_amount,\n\tbase_grand_total,\n\tDATEDIFF(CURDATE(), due_date) AS days_overdue\nFROM `tabPurchase Invoice`\nWHERE docstatus = 1 AND outstanding_amount > 0.005"
					}
				]
			}
		},
